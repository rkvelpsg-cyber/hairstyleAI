NEXT_PUBLIC_SALON_NAME=Maria Salon

NEXT_PUBLIC_PUBLIC_BASE_URL=https://hairstyleailotus.netlify.app

NEXT_PUBLIC_RESULT_EXPIRY_MINUTES=60

# Server-only temporary result storage. Configure these in deployment secrets.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LOOKS_BUCKET=hair-results
CRON_SECRET=

NEXT_PUBLIC_IDLE_RESET_SECONDS=90

NEXT_PUBLIC_WELCOME_VIDEO=/videos/lotus-ai-hairstyle-welcome.mp4

NEXT_PUBLIC_WELCOME_VIDEO_FIT=contain

NEXT_PUBLIC_PRESENCE_FACE_RATIO=0.17

NEXT_PUBLIC_MAX_GENERATIONS_PER_SESSION=6

# mock | fal
HAIR_AI_PROVIDER=mock

# SERVER SECRET - NEVER expose publicly
FAL_KEY=

# Optional Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Multi-view mirror
NEXT_PUBLIC_MIRROR_CAMERA=true

NEXT_PUBLIC_MAX_MULTI_VIEW_LOOKS_PER_SESSION=3

# Browser voice countdown; set false for a silent kiosk
NEXT_PUBLIC_CAPTURE_VOICE=true
